# ============================================================================
# NovaOS Base System Packages
# ============================================================================
# Core packages required for the system to boot and function.
# These are the absolute essentials.
# ============================================================================

# --- Kernel ---
# NOTE: linux-image is installed by live-build via --linux-packages/--linux-flavours
# Do NOT add linux-image-amd64 here or it will conflict with lb's kernel detection

# --- Live System ---
live-boot
live-config
live-config-systemd

# --- Init System ---
systemd-sysv

# --- Bootloader ---
# NOTE: live-build handles the ISO bootloader automatically.
# These packages are for the INSTALLED system (Calamares runs grub-install).
grub-efi-amd64
grub-pc-bin
grub-common
grub2-common
efibootmgr

# --- Firmware ---
firmware-linux-free

# --- Core Utilities ---
sudo
bash
bash-completion
locales
console-setup
keyboard-configuration
apt-utils
ca-certificates
gnupg

# --- Networking ---
network-manager
wpasupplicant
iproute2
iputils-ping

# --- Filesystem ---
e2fsprogs
dosfstools
ntfs-3g
btrfs-progs

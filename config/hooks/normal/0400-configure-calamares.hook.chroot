#!/bin/bash
# ============================================================================
# NovaOS Build Hook: Configure Calamares Installer
# ============================================================================
# Copies Calamares configuration and creates the desktop shortcut.
# ============================================================================

set -e
echo "[NovaOS Hook] Configuring Calamares installer..."

# --- Copy Calamares configuration ---
CALA_DIR="/etc/calamares"
mkdir -p "${CALA_DIR}"
mkdir -p "${CALA_DIR}/modules"
mkdir -p "${CALA_DIR}/branding/novaos"

# Copy settings (these should be in includes.chroot)
if [ -f /tmp/novaos-installer/settings.conf ]; then
    cp /tmp/novaos-installer/settings.conf "${CALA_DIR}/"
fi

if [ -d /tmp/novaos-installer/modules ]; then
    cp /tmp/novaos-installer/modules/*.conf "${CALA_DIR}/modules/"
fi

if [ -d /tmp/novaos-installer/branding/novaos ]; then
    cp -r /tmp/novaos-installer/branding/novaos/* "${CALA_DIR}/branding/novaos/"
fi

# --- Create desktop shortcut for live session ---
mkdir -p /etc/skel/Desktop
cat > /etc/skel/Desktop/install-novaos.desktop << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Install NovaOS
Comment=Install NovaOS to your hard drive
Exec=pkexec calamares
Icon=calamares
Terminal=false
Categories=System;
StartupNotify=true
EOF
chmod +x /etc/skel/Desktop/install-novaos.desktop

# Also put it in system applications
mkdir -p /usr/share/applications
cat > /usr/share/applications/install-novaos.desktop << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Install NovaOS
Comment=Install NovaOS to your hard drive
Exec=pkexec calamares
Icon=calamares
Terminal=false
Categories=System;
StartupNotify=true
EOF

# --- Configure unpackfs module for Calamares ---
cat > "${CALA_DIR}/modules/unpackfs.conf" << 'EOF'
---
unpack:
  - source: /run/live/medium/live/filesystem.squashfs
    sourcefs: squashfs
    destination: ""
EOF

# --- Configure displaymanager module ---
cat > "${CALA_DIR}/modules/displaymanager.conf" << 'EOF'
---
displaymanagers:
  - lightdm
defaultDesktopEnvironment:
    executable: startxfce4
    desktopFile: xfce
basicSetup: false
EOF

echo "[NovaOS Hook] ✅ Calamares installer configured."

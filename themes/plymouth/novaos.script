# ============================================================================
# NovaOS Plymouth Boot Splash Script
# ============================================================================
# Displays a centered NovaOS logo with a rotating spinner animation.
# Uses the Plymouth scripting language.
# ============================================================================

# --- Background ---
# Set a dark background color (#1a1a2e — deep navy/dark blue)
Window.SetBackgroundTopColor(0.10, 0.10, 0.18);
Window.SetBackgroundBottomColor(0.06, 0.06, 0.12);

# --- Logo ---
logo_image = Image("novaos-logo.png");
logo_sprite = Sprite(logo_image);

# Center the logo horizontally, place slightly above center vertically
logo_sprite.SetX(Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2 - 40);
logo_sprite.SetOpacity(1.0);
logo_sprite.SetZ(10);

# --- Spinner Animation ---
# Load spinner frames (spinner-01.png through spinner-36.png)
spinner_frames = 36;
spinner_images = [];

for (i = 0; i < spinner_frames; i++) {
    if (i < 9) {
        spinner_images[i] = Image("spinner-0" + (i + 1) + ".png");
    } else {
        spinner_images[i] = Image("spinner-" + (i + 1) + ".png");
    }
}

spinner_sprite = Sprite();
spinner_sprite.SetZ(10);

# Position spinner below the logo
spinner_x = Window.GetWidth() / 2 - spinner_images[0].GetWidth() / 2;
spinner_y = Window.GetHeight() / 2 + logo_image.GetHeight() / 2;
spinner_sprite.SetX(spinner_x);
spinner_sprite.SetY(spinner_y);

# Animation counter
frame = 0;

# --- Progress Callback ---
# Called by Plymouth on each refresh (~30fps)
fun refresh_callback() {
    spinner_sprite.SetImage(spinner_images[Math.Int(frame) % spinner_frames]);
    frame += 0.5;
}

Plymouth.SetRefreshFunction(refresh_callback);

# --- Message Display ---
message_sprite = Sprite();
message_sprite.SetZ(10);

fun message_callback(text) {
    msg_image = Image.Text(text, 0.6, 0.6, 0.7, "Inter");
    message_sprite.SetImage(msg_image);
    message_sprite.SetX(Window.GetWidth() / 2 - msg_image.GetWidth() / 2);
    message_sprite.SetY(Window.GetHeight() - 50);
}

Plymouth.SetMessageFunction(message_callback);

# --- Password Prompt (for encrypted disks) ---
fun display_password_callback(prompt, bullets) {
    prompt_image = Image.Text(prompt, 1.0, 1.0, 1.0, "Inter");
    prompt_sprite = Sprite(prompt_image);
    prompt_sprite.SetX(Window.GetWidth() / 2 - prompt_image.GetWidth() / 2);
    prompt_sprite.SetY(Window.GetHeight() / 2 + 80);
    
    bullet_str = "";
    for (i = 0; i < bullets; i++) {
        bullet_str += "● ";
    }
    
    bullet_image = Image.Text(bullet_str, 1.0, 1.0, 1.0, "Inter");
    bullet_sprite = Sprite(bullet_image);
    bullet_sprite.SetX(Window.GetWidth() / 2 - bullet_image.GetWidth() / 2);
    bullet_sprite.SetY(Window.GetHeight() / 2 + 110);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);

# --- Quit Callback ---
fun quit_callback() {
    logo_sprite.SetOpacity(0);
    spinner_sprite.SetOpacity(0);
    message_sprite.SetOpacity(0);
}

Plymouth.SetQuitFunction(quit_callback);
